# ==============================================================================
# Blogger Agent Environment Configuration Example
# Copy this file to '.env' and fill in your actual values.
# Do not commit your actual '.env' file to source control!
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION A: Google AI Studio Mode (Standard / Default)
# Use this for local development and prototyping with your standard Gemini API key.
# ------------------------------------------------------------------------------
# GOOGLE_API_KEY=your_ai_studio_gemini_api_key_here


# ------------------------------------------------------------------------------
# OPTION B: Google Cloud Agent Platform Express Mode
# Use this for Vertex AI / Google Cloud Agent Platform Express integration.
# ------------------------------------------------------------------------------
# Feature flag to enable Vertex AI / Enterprise endpoint routing (Required)
GOOGLE_GENAI_USE_ENTERPRISE=1

# Your Google Cloud Project ID and location (Required for Vertex authentication)
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=global

# Your Express Mode API Key (Required for authenticated API requests)
GOOGLE_API_KEY=your_express_mode_api_key_here
