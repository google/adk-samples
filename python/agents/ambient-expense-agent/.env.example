# --- Option A: Google Cloud / Vertex AI (recommended for Agent Runtime) ---
# Requires: gcloud auth application-default login
#
GOOGLE_GENAI_USE_VERTEXAI=TRUE
GOOGLE_CLOUD_PROJECT=<your-project-id>
GOOGLE_CLOUD_LOCATION=global

# --- Option B: Google AI Studio (for local development only) ---
# Get your key at https://aistudio.google.com/apikey
# Note: Agent Runtime deployment requires Vertex AI (Option A).
#
# GOOGLE_API_KEY=PASTE_YOUR_API_KEY_HERE

# Session storage — automatically set by Agent Runtime in production.
# Uncomment for local development with a persistent SQLite session store.
# SESSION_SERVICE_URI=sqlite:///./sessions.db

# Trigger configuration (optional — defaults shown)
# ADK_TRIGGER_MAX_CONCURRENT=10
# ADK_TRIGGER_MAX_RETRIES=3
