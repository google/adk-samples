# Google Cloud Configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# Cloud Run region for the PDF conversion endpoint. The ADK agent itself is
# pinned to the Vertex AI "global" endpoint and ignores this value.
GOOGLE_CLOUD_LOCATION=us-central1
PROJECT_SERVICE_ACCOUNT=your-service-account@your-google-cloud-project-id.iam.gserviceaccount.com

# Google Cloud Storage Buckets
ADK_STAGING_BUCKET=your-staging-bucket-name
ADK_OUTPUT_BUCKET=your-output-bucket-name
LOGS_BUCKET_NAME=your-logs-bucket-name

# LLM Model Configuration
WORKER_MODEL=gemini-2.5-pro

# Reasoning Engine (assigned after first deployment to Agent Engine)
REASONING_ENGINE=projects/your-project-id/locations/us-central1/reasoningEngines/your-reasoning-engine-id

# External Services
# The URL to the deployed Cloud Run service for PDF conversion
CONVERSION_SERVICE_URL=https://your-conversion-service-url.a.run.app
