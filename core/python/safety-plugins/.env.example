# Copy as .env file and fill your values below

# Choose 1 for Gemini Vertex AI or 0 Gemini Developer API 
GOOGLE_GENAI_USE_VERTEXAI=1

GOOGLE_API_KEY=YOUR_VALUE_HERE #  'Google Gemini Developer API Key, required if GOOGLE_GENAI_USE_VERTEXAI=0.'

# Vertex backend config
GOOGLE_CLOUD_PROJECT=YOUR_PROJECT_ID_HERE
GOOGLE_CLOUD_LOCATION=us-central1

# Your Model Armor template in your Google Cloud project.
MODEL_ARMOR_TEMPLATE_ID=YOUR_TEMPLATE_ID_HERE

# Renamed from hardcoded string in source. Rename the variable if needed.
MODEL_NAME_GENERATED_1=gemini-3.5-flash
MODEL_NAME_GENERATED_2=gemini-3.1-flash-lite
