flowchart TB
    Client["Client
Vite chat shell · A2A peer · agents-cli one-shot"]

    subgraph Runner["lha Runner · FastAPI · ADK 2.5"]
        direction TB
        Plugins["plugins  IterationBudget · SiblingAgent · Guardrails"]
        Prompt["prompt  3-tier (stable · cached · volatile + skills)"]
        Model["model  DispatchingLlm → Gemini 3.6 Flash / 3.1 Pro"]
        Compact["compact  HorizonSummarizer over old events"]
    end

    subgraph Tools["Tools"]
        direction TB
        ToolList["terminal · file_ops · web
clarify · add_memory
delegate · agent (fork)"]
    end

    subgraph Vertex["Vertex AI"]
        direction TB
        MemoryBank["Memory Bank
cross-session"]
        AgentEngine["Agent Engine
sessions"]
        AgentRuntime["Agent Runtime
sandbox"]
    end

    subgraph Sandbox["Sandbox"]
        direction TB
        SandboxDetail["local fs (dev) · BYOC sandbox container (prod)
daily snapshot (opt-in)"]
    end

    Client -->|"A2A JSON-RPC + SSE — structured UI parts stream back"| Runner
    Runner -->|"tool call"| Tools
    Runner -->|"search_memory"| Vertex
    Tools --> Sandbox

    %% self-improvement loop
    Judge["after every turn ▸ judge fork writes memories
and patches skills — never blocks the reply"]
    Dream["on a schedule ▸ dream review reads recent
sessions and curates the user_profile"]
    Surface["next turn ▸ both surface back via Memory Bank
and the 3-tier system prompt"]

    Runner -.->|"↻ it dreams"| Judge
    Judge --> Dream
    Dream --> Surface
    Surface -.->|"closes the loop"| Runner

