# Model Configuration
MODEL_NAME=gemini-3.7-flash

# Workloads to optimize (defaults to the bundled app/data/workloads.csv)
# WORKLOADS_CSV=/path/to/your_workloads.csv

# Evolution loop configuration
MAX_EVALUATIONS=10
POPULATION_SIZE=4
CANDIDATE_TIMEOUT_SECONDS=10

# Google Cloud Platform Configuration (for Vertex AI)
# GOOGLE_CLOUD_PROJECT=<TODO: update-this-value>
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=<TODO: update-this-value>

# Web Server Configuration
# ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Telemetry and Logging Configuration
# LOGS_BUCKET_NAME=your-gcs-bucket-name
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# GENAI_TELEMETRY_PATH=completions
# COMMIT_SHA=dev

# Serving Configuration (used by the generated fast_api_app.py / app_utils)
# APP_URL=https://your-service-url
# SESSION_SERVICE_URI=agentengine://your-agent-engine-id
# GOOGLE_CLOUD_AGENT_ENGINE_ID=your-agent-engine-id
# GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
# INTEGRATION_TEST=FALSE
