# Model Configuration
MODEL_NAME=gemini-3.7-flash

# Google Cloud Platform Configuration (for Vertex AI)
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global
# GOOGLE_GENAI_USE_VERTEXAI=True

# Google AI Studio Configuration (if using API Key instead of Vertex AI)
# GEMINI_API_KEY=your-api-key

# Forecast data source: "sample" (bundled synthetic ensemble, default) or
# "bigquery" (WeatherNext 3 statistics via the BigQuery Analytics Hub listing).
# WEATHERNEXT_SOURCE=sample
# Full id of the linked WeatherNext table, e.g. my-project.weathernext.weathernext_3_0_0_0p1deg
# WEATHERNEXT_BQ_TABLE=your-project.your_dataset.weathernext_3_0_0_0p1deg
# Project billed for BigQuery queries (defaults to the client's project).
# WEATHERNEXT_BQ_PROJECT=your-project-id
# Pin a forecast init time (UTC, ISO 8601). Default: latest 6-hourly init in the last 2 days.
# WEATHERNEXT_INIT_TIME=2026-10-12T00:00:00Z
# Maximum forecast lead time to load, in hours (up to 360 for 6-hourly inits).
# WEATHERNEXT_MAX_HOURS=120

# Your own sites and (member-level) forecast file instead of the bundled sample.
# SITES_JSON=/path/to/sites.json
# SAMPLE_FORECAST_JSON=/path/to/forecast.json

# Planning assumptions (see app/config.py).
# TASK_LIMITS_JSON={"main_component_lift": {"max_wind_ms": 9.0}}
# GUST_FACTOR=1.35
# SHEAR_EXPONENT=0.14

# Web Server Configuration
# ALLOW_ORIGINS=http://localhost:3000,http://localhost:8080

# Telemetry and Logging Configuration
# LOGS_BUCKET_NAME=your-gcs-bucket-name
# OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=NO_CONTENT
# OTEL_INSTRUMENTATION_GENAI_UPLOAD_FORMAT=jsonl
# OTEL_INSTRUMENTATION_GENAI_COMPLETION_HOOK=upload
# OTEL_SEMCONV_STABILITY_OPT_IN=gen_ai_latest_experimental
# GENAI_TELEMETRY_PATH=completions
# COMMIT_SHA=dev

# Serving Configuration (used by app/fast_api_app.py and app/app_utils/)
# APP_URL=https://your-service-url
# SESSION_SERVICE_URI=agentengine://your-agent-engine-id
# GOOGLE_CLOUD_AGENT_ENGINE_ID=your-agent-engine-id
# GOOGLE_CLOUD_AGENT_ENGINE_LOCATION=us-central1
# INTEGRATION_TEST=FALSE
