GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT="YOUR_GCP_PROJECT_ID"
GOOGLE_CLOUD_LOCATION="global"

GCS_BUCKET_NAME="YOUR_GCS_BUCKET_NAME"
SCORE_THRESHOLD=45
MAX_ITERATIONS=2
IMAGE_GEN_MODEL="gemini-2.5-flash-image"
GENAI_MODEL="gemini-3.5-flash"

# Reasoning Engine / Deployment configuration (used by deployment/deploy.py)
# AGENT_ENGINE_ID is populated with the resource ID after running deployment/deploy.py
AGENT_ENGINE_ID=""
# Optional override for the deployment staging bucket (defaults to {project_id}-adk-staging if omitted)
GOOGLE_CLOUD_STORAGE_BUCKET=<TODO: update-this-value>
# Project ID and location for Vertex AI Reasoning Engine image generation
RE_PROJECT_ID=<TODO: update-this-value>
RE_LOCATION=global
