# Copy to .env and fill in. Loaded automatically for local runs.

# GitHub token with `issues: write` on the target repository.
GITHUB_TOKEN=your_github_token_here

# Model credentials: either a Gemini API key...
GEMINI_API_KEY=your_api_key_here
# ...or use Vertex AI via Application Default Credentials instead:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_project
# GOOGLE_CLOUD_LOCATION=global

# Target repository to audit (required; no default).
OWNER=target_repository_owner
REPO=target_repository_name

# Maintainer GitHub logins (comma-separated). REQUIRED: the default GITHUB_TOKEN
# cannot list collaborators, so the maintainer set must be provided explicitly.
MAINTAINERS=octocat,hubot

# Optional overrides.
LLM_MODEL_NAME=gemini-flash-latest
STALE_HOURS_THRESHOLD=336              # 14 days waiting on the author -> warn
CLOSE_HOURS_AFTER_STALE_THRESHOLD=168 # 7 more days stale -> close
STALE_LABEL_NAME=stale
REQUEST_CLARIFICATION_LABEL=request clarification
CONCURRENCY_LIMIT=3
ISSUE_TIMEOUT=5m
